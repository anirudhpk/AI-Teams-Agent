{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Graph Webhook (Uvicorn)",
        "type": "python",
        "request": "launch",
        "module": "uvicorn",
        "args": [
          "graph_webhook:app",
          "--host",
          "0.0.0.0",
          "--port",
          "8000"
        ],
        "envFile": "${workspaceFolder}/.env",
        "console": "integratedTerminal"
      },
      {
        "name": "Debug Batch Job",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/batch_job.py",
        "console": "integratedTerminal",
        "envFile": "${workspaceFolder}/.env"
      }
    ]
  }